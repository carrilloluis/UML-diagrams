@startuml
	hide circle
	skin rose
	hide empty members

	' abstract
	class "<<Desplazable>>" as e01
	class "Vehículo" as e02
	class "Moto" as e03
	class "Coche" as e04
	class "Conductor" as e05
	class "Pasajeros" as e06
	
	e01 <|.. e02
	e05 ..> e02
	e02 <|-- e03
	e02 <|-- e04
	e02 o--> "*" e06
@enduml